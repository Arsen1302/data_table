{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "browser": true,
    "es2023": true
  },
  "ignorePatterns": ["dist", "src/routeTree.gen.ts"],
  "rules": {
    "react/react-in-jsx-scope": "off"
  }
}
